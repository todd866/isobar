<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>md.isobar.chat-daemon</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>__ISOBAR_REPO__/tools/chat-daemon/run.sh</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__ISOBAR_HOME__/.local/state/isobar-chat-daemon/launchd.log</string>
  <key>StandardErrorPath</key><string>__ISOBAR_HOME__/.local/state/isobar-chat-daemon/launchd.error.log</string>
</dict></plist>
