// Fragment-only relief; heights remain physical. Included in Metal source.
"static float terrainWrap(float x) {\n"
"    float y = fmod(x, 360.0);\n"
"    if (y < 0.0) y += 360.0;\n"
"    return y;\n"
"}\n"
"static float3 hypsometric(float3 low, float metres, float dark) {\n"
"    float3 hill = mix(float3(0.920, 0.880, 0.680), float3(0.448, 0.382, 0.246), dark);\n"
"    float3 range = mix(float3(0.855, 0.808, 0.690), float3(0.470, 0.425, 0.335), dark);\n"
"    float3 peak = mix(float3(0.945, 0.940, 0.920), float3(0.560, 0.550, 0.520), dark);\n"
"    float3 c = mix(low, hill, smoothstep(40.0, 450.0, metres));\n"
"    c = mix(c, range, smoothstep(600.0, 2000.0, metres));\n"
"    return mix(c, peak, smoothstep(2400.0, 3800.0, metres));\n"
"}\n"
"static float2 terrainSample(texture2d<float> terrain, float2 uv) {\n"
"    constexpr sampler smp(mag_filter::linear, min_filter::linear, address::clamp_to_edge);\n"
"    float2 t = terrain.sample(smp, uv).rg;\n"
"    return float2(t.g > 0.999 ? t.r / t.g : 0.0, t.g);\n"
"}\n"
"static float3 relieve(float3 land, float lat, float lon, constant U &u, texture2d<float> dem) {\n"
"    float span = u.terrainBox.z - u.terrainBox.x;\n"
"    float vspan = u.terrainBox.w - u.terrainBox.y;\n"
"    if (!(u.terrain.z > 0.001) || !(span > 0.001) || !(vspan > 0.001) || span >= 360.0) return land;\n"
"    float tu = terrainWrap(lon - u.terrainBox.x) / span;\n"
"    float tv = (lat - u.terrainBox.y) / vspan;\n"
"    if (tu < 0.0 || tv < 0.0 || tu > 1.0 || tv > 1.0) return land;\n"
"    float2 uv = float2(tu, tv);\n"
"    float2 here = terrainSample(dem, uv);\n"
"    if (!(here.y > 0.999)) return land;\n"
"    float2 e = terrainSample(dem, uv + float2(u.terrain.x, 0.0));\n"
"    float2 w = terrainSample(dem, uv - float2(u.terrain.x, 0.0));\n"
"    float2 n = terrainSample(dem, uv + float2(0.0, u.terrain.y));\n"
"    float2 s = terrainSample(dem, uv - float2(0.0, u.terrain.y));\n"
"    float cover = min(min(e.y, w.y), min(n.y, s.y)) > 0.999 ? 1.0 : 0.0;\n"
"    float dx = u.terrain.x * span * 111320.0 * max(cos(lat * 0.01745329251), 0.05);\n"
"    float dy = u.terrain.y * vspan * 110574.0;\n"
"    if (!(dx > 1.0) || !(dy > 1.0)) {\n"
"        return mix(land, hypsometric(land, here.x, u.terrain.w), 0.55 * u.terrain.z * here.y);\n"
"    }\n"
"    float exaggeration = 1.5;\n"
"    float gx = (e.x - w.x) / (2.0 * dx) * exaggeration;\n"
"    float gy = (n.x - s.x) / (2.0 * dy) * exaggeration;\n"
"    float3 normal = normalize(float3(-gx, -gy, 1.0));\n"
"    float shade = 0.15 * max(dot(normal, float3(-0.5, -0.5, 0.7071)), 0.0)\n"
"        + 0.25 * max(dot(normal, float3(-0.7071, 0.0, 0.7071)), 0.0)\n"
"        + 0.40 * max(dot(normal, float3(-0.5, 0.5, 0.7071)), 0.0)\n"
"        + 0.20 * max(dot(normal, float3(0.0, 0.7071, 0.7071)), 0.0);\n"
"    float delta = (shade - 0.7071) * u.terrain.z * cover;\n"
"    float3 tinted = mix(land, hypsometric(land, here.x, u.terrain.w), 0.55 * u.terrain.z * here.y);\n"
"    float darken = mix(0.75, 0.9, u.terrain.w);\n"
"    float lighten = mix(0.4, 0.25, u.terrain.w);\n"
"    return tinted * (1.0 + darken * min(delta, 0.0)) + (float3(1.0) - tinted) * lighten * max(delta, 0.0);\n"
"}\n"
"static float2 terrainAt(float lat, float lon, constant U &u, texture2d<float> dem) {\n"
"    float2 span=u.terrainBox.zw-u.terrainBox.xy;\n"
"    if(u.terrain.z<=0.001 || span.x<=0.0 || span.y<=0.0) return float2(0.0);\n"
"    float2 uv=float2(terrainWrap(lon-u.terrainBox.x),lat-u.terrainBox.y)/span;\n"
"    if(any(uv<0.0) || any(uv>1.0)) return float2(0.0);\n"
"    float2 sample=terrainSample(dem,uv);\n"
"    return sample.y>0.999 ? sample : float2(0.0);\n"
"}\n"
// ---- 3D terrain: one displayed surface shared with terrainscene.m ----------
// demRead is a manual bilinear so the CPU (TerrainGridSample) and the GPU
// read the same heights. Returns (metres, valid, edge weight).
"static float3 demRead(texture2d<float> t, float4 box, float lat, float lon) {\n"
"    float span = box.z - box.x, vspan = box.w - box.y;\n"
"    if (!(span > 0.0) || !(vspan > 0.0)) return float3(0.0);\n"
"    float rel = terrainWrap(lon - box.x);\n"
"    if (rel > span || lat < box.y || lat > box.w) return float3(0.0);\n"
"    float w = float(t.get_width()), h = float(t.get_height());\n"
"    float uu = rel / span, vv = (lat - box.y) / vspan;\n"
"    float x = clamp(uu * w - 0.5, 0.0, w - 1.0), y = clamp(vv * h - 0.5, 0.0, h - 1.0);\n"
"    uint x0 = uint(floor(x)), y0 = uint(floor(y));\n"
"    uint x1 = min(x0 + 1u, uint(w) - 1u), y1 = min(y0 + 1u, uint(h) - 1u);\n"
"    float a = x - float(x0), b = y - float(y0);\n"
"    float2 p00 = t.read(uint2(x0, y0)).rg, p10 = t.read(uint2(x1, y0)).rg;\n"
"    float2 p01 = t.read(uint2(x0, y1)).rg, p11 = t.read(uint2(x1, y1)).rg;\n"
"    if (min(min(p00.y, p10.y), min(p01.y, p11.y)) < 1.0) return float3(0.0);\n"
"    float v = (1.0 - b) * ((1.0 - a) * p00.x + a * p10.x) + b * ((1.0 - a) * p01.x + a * p11.x);\n"
"    float edge = smoothstep(0.0, 0.06, min(min(uu, 1.0 - uu), min(vv, 1.0 - vv)));\n"
"    return float3(v, 1.0, edge);\n"
"}\n"
// Fine near mosaic blended into the coarse far ring; missing stays sea level.
"static float terrainGround(float lat, float lon, constant U &u, texture2d<float> near, texture2d<float> far) {\n"
"    float3 n = demRead(near, u.nearBox, lat, lon);\n"
"    float3 f = demRead(far, u.farBox, lat, lon);\n"
"    float h = n.y > 0.5 ? (f.y > 0.5 ? mix(f.x, n.x, n.z) : n.x) : (f.y > 0.5 ? f.x : 0.0);\n"
"    return max(h, 0.0);\n"
"}\n"
"static float meshOffset(float i, constant U &u) {\n"
"    float a = abs(i), n0 = u.t2.x, r = u.t2.z;\n"
"    float o = a <= n0 ? a : (r - 1.0 < 1e-6 ? a : n0 + r * (pow(r, a - n0) - 1.0) / (r - 1.0));\n"
"    return i < 0.0 ? -o : o;\n"
"}\n"
"static float meshIndex(float o, constant U &u) {\n"
"    float a = abs(o), n0 = u.t2.x, r = u.t2.z;\n"
"    float i = a <= n0 ? a : (r - 1.0 < 1e-6 ? a : n0 + log(1.0 + (a - n0) * (r - 1.0) / r) / log(r));\n"
"    return o < 0.0 ? -i : i;\n"
"}\n"
"static float meshLat(float i, constant U &u) { return clamp(u.t1.x + meshOffset(i, u) * u.t1.z, -89.5, 89.5); }\n"
"static float meshLon(float j, constant U &u) { return u.t1.y + meshOffset(j, u) * u.t1.w; }\n"
// Height of the drawn triangle mesh at a point: what the eye sees.
"static float meshHeight(float lat, float lon, constant U &u, texture2d<float> near, texture2d<float> far) {\n"
"    float N = u.t2.w;\n"
"    float iy = meshIndex((lat - u.t1.x) / u.t1.z, u);\n"
"    float ix = meshIndex(wrap180(lon - u.t1.y) / u.t1.w, u);\n"
"    if (abs(iy) >= N || abs(ix) >= N) return 0.0;\n"
"    float cy = floor(iy), cx = floor(ix);\n"
"    float la0 = u.t1.x + meshOffset(cy, u) * u.t1.z, la1 = u.t1.x + meshOffset(cy + 1.0, u) * u.t1.z;\n"
"    float lo0 = meshOffset(cx, u) * u.t1.w, lo1 = meshOffset(cx + 1.0, u) * u.t1.w;\n"
"    float b = clamp((lat - la0) / (la1 - la0), 0.0, 1.0);\n"
"    float a = clamp((wrap180(lon - u.t1.y) - lo0) / (lo1 - lo0), 0.0, 1.0);\n"
"    float h00 = terrainGround(meshLat(cy, u), meshLon(cx, u), u, near, far);\n"
"    float h10 = terrainGround(meshLat(cy, u), meshLon(cx + 1.0, u), u, near, far);\n"
"    float h01 = terrainGround(meshLat(cy + 1.0, u), meshLon(cx, u), u, near, far);\n"
"    float h11 = terrainGround(meshLat(cy + 1.0, u), meshLon(cx + 1.0, u), u, near, far);\n"
"    if (a + b <= 1.0) return h00 + a * (h10 - h00) + b * (h01 - h00);\n"
"    return h11 + (1.0 - a) * (h01 - h11) + (1.0 - b) * (h10 - h11);\n"
"}\n"
