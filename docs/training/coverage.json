  "rules": [
    {
      "concept": "fpl.cruise-level",
      "au_us": "Both use a hemispheric / semicircular rule on magnetic track, and the tables are not the same. Australia teaches the AIP table, including the VFR offset. The US teaches 14 CFR 91.179. Do not grade one table against the other. practiceLocale is required.",
      "easa": "gap",
      "ca": "reuses US"
    },
    {
      "concept": "fpl.fuel-plan",
      "au_us": "Reserve basis and contingency differ by edition and operation.",
      "easa": "gap",
      "ca": "gap"
    },
    {
      "concept": "fpl.taf-threshold",
      "au_us": "The arithmetic of 'which group is worse' is shared. The legal alternate test is not. Australia uses the AIP alternate minima and the INTER/TEMPO planning rules. The US uses 14 CFR 91.169 and the part 121 minima. A live card states a teaching threshold in metres and feet. It does not claim to be the AIP or the CFR.",
      "easa": "gap",
      "ca": "gap"
    },
    {
      "concept": "hum.fatigue-rules",
      "au_us": "The physiology of fatigue is shared. The legal limits are not. CAO 48.1 and the CASRs are the Australian source. 14 CFR part 117 is the US flag source. practiceLocale is required. Do not blend the numbers.",
      "easa": "gap",
      "ca": "gap"
    },
    {
      "concept": "law.alternate",
      "au_us": "Australia: AIP alternate minima, special alternate minima, and the planning treatment of INTER and TEMPO. United States: 14 CFR 91.169 for part 91, and the part 121 dispatch minima, which are not the 600-2 / 800-2 slogan unless the card cites the paragraph that still says so. Today's TAF can illustrate a group. The legal conclusion is bank-only and locale-specific.",
      "easa": "gap",
      "ca": "gap"
    },
    {
      "concept": "law.documents",
      "au_us": "Not interchangeable. Australian ATPL privileges are in CASR Part 61. US ATP privileges are in 14 CFR 61.167. A question written for one is not a translation of the other.",
      "easa": "gap",
      "ca": "gap"
    },
    {
      "concept": "law.flight-rules",
      "au_us": "",
      "easa": "gap",
      "ca": "gap"
    },
    {
      "concept": "law.transition-altitude",
      "au_us": "Australia transitions at 10,000 ft with the layer up to FL110. The United States transitions at 18,000 ft and FL180. A card that swaps these is testing the wrong country. The QNH on today's METAR can be the stem. The scored fact is the country's transition altitude.",
      "easa": "gap",
      "ca": "reuses US"
    },
    {
      "concept": "law.vfr-minima",
      "au_us": "Class C visibility and cloud separations differ between Australia and the US.",
      "easa": "gap",
      "ca": "gap"
    },
    {
      "concept": "met.ceiling",
      "au_us": "Shared cloud-amount rule. Australian TAFs add INTER and use CAVOK. US TAFs do not.",
      "easa": "gap",
      "ca": "gap"
    },
    {
      "concept": "met.taf-groups",
      "au_us": "INTER is Australian (and ICAO) and is not a US TAF group. CAVOK is used in Australian METAR and TAF and is not used in US METAR. TEMPO and FM exist in both. A card graded on an Australian TAF must not treat INTER as TEMPO, and a US card must not offer CAVOK as a choice.",
      "easa": "gap",
      "ca": "gap"
    },
    {
      "concept": "perf.pressure-altitude",
      "au_us": "Shared definition: the altitude in the ISA with the same pressure. Australian QNH is hPa. US altimeter settings are inHg. The 30 ft per hPa rule is a sea-level approximation, and the card must say so.",
      "easa": "gap",
      "ca": "reuses US"
    }
  ]
}
